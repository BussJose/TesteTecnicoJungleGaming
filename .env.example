# Copie para .env se quiser mudar algo (o docker compose usa este arquivo como base).
# Valores abaixo servem para rodar o programa FORA do Docker (go run ./cmd/server).

HTTP_ADDR=:8080
LOG_LEVEL=info
DB_MAX_CONNS=20
# INSTANCE_ID=api-1            # opcional; por padrão usa o nome da máquina

DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable

# AWS / LocalStack (credenciais de mentira, aceitas pelo LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo

# Keycloak. ISSUER = valor esperado em "iss"; JWKS_URL = onde buscar as chaves públicas.
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=wager
KEYCLOAK_CLIENT_ID=wager-api          # audiência (aud) exigida nos tokens
# KEYCLOAK_ISSUER=http://localhost:8081/realms/wager
# KEYCLOAK_JWKS_URL=http://localhost:8081/realms/wager/protocol/openid-connect/certs

# Referências pendentes (estorno/rollback/win que chegam antes da aposta)
REFERENCE_TTL=5m
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_BACKOFF_BASE=1s
REFERENCE_BACKOFF_MAX=30s
PENDING_POLL_INTERVAL=1s
